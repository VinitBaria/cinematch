# CineMatch AI - Environment Variables
# Copy this to .env and fill in your values

# TMDB API (for movie posters and metadata in Phase 2+)
TMDB_API_KEY=your_tmdb_api_key_here

# MongoDB (Phase 2+)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cinematch_ai

# JWT Secret (Phase 2+)
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# App Config
APP_ENV=development
APP_DEBUG=true
