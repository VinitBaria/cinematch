    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 200,
      "title": "🚨 Data Drift Detection & Model Governance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Real-time model data drift health status. Green indicates incoming ratings match the baseline training distribution. Red indicates significant data drift detected, triggering automated retrain workflows.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "green", "text": "🟢 HEALTHY\n(IN-SYNC)" },
                "1": { "color": "red", "text": "🔴 DRIFT DETECTED\n(RETRAIN NEEDED)" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 15 },
      "id": 203,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "10.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "max(cinematch_data_drift_detected) or vector(0)",
          "instant": true,
          "legendFormat": "Drift Status",
          "refId": "A"
        }
      ],
      "title": "🚨 Live Model Drift Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Comparison between the model's expected baseline training rating mean and current live production ratings in MongoDB, with the drift delta (Δ).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "🟦 Baseline Mean (Training)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#3274D9", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "🟩 Live Production Mean" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#56A64B", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Shift Delta (Δ)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": -0.30 },
                    { "color": "green", "value": -0.15 },
                    { "color": "yellow", "value": 0.15 },
                    { "color": "red", "value": 0.30 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 10, "x": 6, "y": 15 },
      "id": 201,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "avg(cinematch_drift_baseline_mean_rating)",
          "instant": true,
          "legendFormat": "🟦 Baseline Mean (Training)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "avg(cinematch_drift_production_mean_rating)",
          "instant": true,
          "legendFormat": "🟩 Live Production Mean",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "avg(cinematch_drift_production_mean_rating) - avg(cinematch_drift_baseline_mean_rating)",
          "instant": true,
          "legendFormat": "Shift Delta (Δ)",
          "refId": "C"
        }
      ],
      "title": "⭐ Mean Rating Shift (Baseline vs. Live)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 500,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 250 },
              { "color": "green", "value": 450 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 202,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(cinematch_ratings_submitted_total) or vector(0)",
          "legendFormat": "Ratings Collected",
          "refId": "A"
        }
      ],
      "title": "📈 Fresh Data Accumulated (Retrain Readiness / 500)",
      "type": "gauge"
    }
  ],
