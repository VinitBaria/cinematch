        "tooltip": { "mode": "single", "sort": "none" }
      },
      "pluginVersion": "10.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "up{job=\"cinematch_backend\"}",
          "legendFormat": "Backend API Service",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "🟢 Service Uptime Timeline",
